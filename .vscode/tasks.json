{
    "version": "2.0.0",

    "tasks": [
        {
            "type": "shell",
            "label": "Build Ray Tracer",

            "command": "g++",

            "args": [
                "-g",

                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/src/ray.cpp",

                "-I${workspaceFolder}/includes",
                "-I${workspaceFolder}",

                "-o",
                "${workspaceFolder}/main.exe"
            ],

            "options": {
                "cwd": "${workspaceFolder}"
            },

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}